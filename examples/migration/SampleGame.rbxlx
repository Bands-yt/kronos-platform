        <Properties>
          <string name="Name">LobbyController</string>
          <string name="Source">-- Legacy Roblox script, kept verbatim as a migration sample.
local Players = game:GetService("Players")
local pad = workspace.Lobby.SpawnPad

Players.PlayerAdded:Connect(function(player)
    local marker = Instance.new("Part")
    marker.Parent = workspace
end)

game:GetService("RunService").Heartbeat:Connect(function(dt)
    -- per-frame work
end)</string>
        </Properties>
