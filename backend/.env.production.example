# Kronos production environment.
#
# Copy to .env.production and fill in. NEVER commit the filled-in file.
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d
#
# Generate each secret with:
#   openssl rand -base64 48

# --- edge / TLS -------------------------------------------------------------
# Must already resolve to this host, with ports 80 and 443 reachable, or
# Let's Encrypt cannot complete its challenge.
KRONOS_DOMAIN=api.kronos.example
KRONOS_ACME_EMAIL=you@example.com

# --- secrets ----------------------------------------------------------------
# Signs access tokens. Rotating it invalidates every access token
# immediately (refresh tokens survive, since those are database rows).
JWT_SECRET=

# Signs the short-lived join tickets a client hands to a game server.
# Deliberately SEPARATE from JWT_SECRET: game servers need to verify
# tickets without holding the key that mints login sessions.
JOIN_TICKET_SECRET=

# --- database ---------------------------------------------------------------
POSTGRES_USER=kronos
POSTGRES_DB=kronos
POSTGRES_PASSWORD=

# DATABASE_URL and REDIS_URL are composed from the values above inside
# docker-compose.prod.yml. Set them explicitly only if you are pointing at
# a managed database instead of the bundled containers:
# DATABASE_URL=postgres://user:pass@host:5432/kronos
# REDIS_URL=redis://host:6379

# --- optional ---------------------------------------------------------------
# Google OAuth 2.0 client id. Must match the one the launcher uses -- it is
# the audience every Google ID token is verified against. Leave blank to
# disable Google sign-in (the service then refuses all Google tokens
# rather than accepting unverifiable ones).
GOOGLE_CLIENT_ID=

PORT=8080
