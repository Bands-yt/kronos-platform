# Copy to .env and fill in. The service refuses to start in production
# without real values for the two secrets below.
NODE_ENV=development
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080

DATABASE_URL=postgres://kronos:devpass@127.0.0.1:55432/kronos
REDIS_URL=redis://127.0.0.1:56379

# openssl rand -base64 48
JWT_SECRET=
JOIN_TICKET_SECRET=

# Google Cloud OAuth 2.0 client id (Application type: Desktop app).
# Must be the SAME client id the C++ launcher uses -- it is the audience
# every Google ID token is verified against.
GOOGLE_CLIENT_ID=
