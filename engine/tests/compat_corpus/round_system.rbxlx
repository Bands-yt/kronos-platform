 class="StringValue" referent="RBX6"><Properties><string name="Name">Status</string></Properties></Item><Item class="IntValue" referent="RBX7"><Properties><string name="Name">Round</string></Properties></Item></Item><Item class="ServerScriptService" referent="RBX10"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX9"><Properties><string name="Name">RoundManager</string><ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local status = ReplicatedStorage.Status
local round = ReplicatedStorage.Round
local INTERMISSION = 3
local ROUND_LENGTH = 5

local function teleportAll(target)
	for i, player in Players:GetPlayers() do
		local character = player.Character
		if character and character.PrimaryPart then
			character:PivotTo(CFrame.new(target.Position + Vector3.new(i * 3, 3, 0)))
		end
	end
end

while true do
	for t = INTERMISSION, 1, -1 do
		status.Value = "Intermission: " .. t
		task.wait(1)
	end
	round.Value += 1
	status.Value = "Round " .. round.Value
	teleportAll(workspace.ArenaSpawn)
	task.wait(ROUND_LENGTH)
	status.Value = "Round over"
	teleportAll(workspace.SpawnLocation)
	task.wait(1)
end
]]></ProtectedString></Properties></Item></Item></roblox>
