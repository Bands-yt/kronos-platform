-- Behaviour checks for inventory.rbxlx.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Items = require(ReplicatedStorage.Items)
check("the shared Items module loads", Items.price("Apple") == 5)
check("players start with 50 gold", player:GetAttribute("Gold") == 50)
local ok, count = ReplicatedStorage.Buy:InvokeServer("Apple")
check("buying an Apple works", ok == true and count == 1 and player:GetAttribute("Gold") == 45, tostring(ok) .. " " .. tostring(count))
ReplicatedStorage.Buy:InvokeServer("Apple")
ReplicatedStorage.Buy:InvokeServer("Potion")
task.wait(0.1)
check("the client hears about the inventory", player:GetAttribute("ItemCount") == 3, tostring(player:GetAttribute("ItemCount")))
local refused, reason = ReplicatedStorage.Buy:InvokeServer("Shield")
check("buying without enough gold is refused", refused == false and reason == "not enough gold" and player:GetAttribute("Gold") == 25, tostring(reason))
local bad, why = ReplicatedStorage.Buy:InvokeServer({})
check("a bad item name is refused", bad == false and why == "no such item", tostring(why))
