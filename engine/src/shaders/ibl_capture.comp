#version 450

// Renders the procedural sky (no sun disk; the sun is an analytic light)
// into mip 0 of the environment cube. The lower hemisphere fades to the
// preset's ground bounce colour so reflections of "the ground" match the
// hemisphere ambient instead of mirroring the sky.

#include "kronos/sky.glsl"
#include "kronos/cubemap.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(set = 0, binding = 0, rgba16f) uniform writeonly image2DArray envOut;

layout(push_constant) uniform CapturePush {
    vec4 zenith;
    vec4 horizon;
    vec4 sunDir;
    vec4 origin;
    vec4 atmosphere;
    vec4 clouds;
    vec4 ground;
} pc;

void main() {
    uint size = uint(imageSize(envOut).x);
    uvec3 id = gl_GlobalInvocationID;
    if (id.x >= size || id.y >= size) return;
    vec3 dir = cubeTexelDirection(id.z, id.xy, size);

    SkyInputs s;
    s.zenith = pc.zenith.rgb;
    s.horizon = pc.horizon.rgb;
    s.sunDir = pc.sunDir.xyz;
    s.origin = pc.origin.xyz;
    s.atmosphere = pc.atmosphere;
    s.clouds = pc.clouds;
    vec3 radiance = skyRadiance(s, vec3(dir.x, max(dir.y, 0.0), dir.z));
    radiance = mix(radiance, pc.ground.rgb, smoothstep(0.0, 0.15, -dir.y));
    imageStore(envOut, ivec3(id), vec4(max(radiance, vec3(0.0)), 1.0));
}
