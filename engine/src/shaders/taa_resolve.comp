#version 450

// Temporal anti-aliasing resolve.
//  - Motion: velocity of the nearest-depth texel in a 3x3 neighbourhood
//    (edges take the foreground's motion, so silhouettes don't smear).
//  - History: 5-tap Catmull-Rom, which keeps the resolve sharp under motion.
//  - Rejection: variance clipping in YCoCg (Salvi 2016) against the
//    current neighbourhood, clipping toward the mean rather than clamping.
//  - Blend in a luminance-weighted space (Karis 2014) so HDR highlights
//    don't flicker.

#include "kronos/common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D currentColor;
layout(set = 0, binding = 1) uniform sampler2D historyColor;
layout(set = 0, binding = 2) uniform sampler2D velocityTex;
layout(set = 0, binding = 3) uniform sampler2D depthTex;
layout(set = 0, binding = 4, rgba16f) uniform writeonly image2D resolved;

layout(push_constant) uniform TaaPush {
    vec2 invSize;
    float feedback;    // weight of the current frame in steady state
    float resetHistory;
} pc;

vec3 rgbToYCoCg(vec3 c) {
    return vec3(0.25 * c.r + 0.5 * c.g + 0.25 * c.b, 0.5 * c.r - 0.5 * c.b, -0.25 * c.r + 0.5 * c.g - 0.25 * c.b);
}

vec3 yCoCgToRgb(vec3 c) {
    return vec3(c.x + c.y - c.z, c.x + c.z, c.x - c.y - c.z);
}

vec3 sampleHistoryCatmullRom(vec2 uv, vec2 size) {
    vec2 samplePos = uv * size;
    vec2 texPos1 = floor(samplePos - 0.5) + 0.5;
    vec2 f = samplePos - texPos1;
    vec2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
    vec2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
    vec2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
    vec2 w3 = f * f * (-0.5 + 0.5 * f);
    vec2 w12 = w1 + w2;
    vec2 offset12 = w2 / w12;
    vec2 texPos0 = (texPos1 - 1.0) / size;
    vec2 texPos3 = (texPos1 + 2.0) / size;
    vec2 texPos12 = (texPos1 + offset12) / size;

    vec3 r = vec3(0.0);
    r += textureLod(historyColor, vec2(texPos12.x, texPos0.y), 0.0).rgb * w12.x * w0.y;
    r += textureLod(historyColor, vec2(texPos0.x, texPos12.y), 0.0).rgb * w0.x * w12.y;
    r += textureLod(historyColor, vec2(texPos12.x, texPos12.y), 0.0).rgb * w12.x * w12.y;
    r += textureLod(historyColor, vec2(texPos3.x, texPos12.y), 0.0).rgb * w3.x * w12.y;
    r += textureLod(historyColor, vec2(texPos12.x, texPos3.y), 0.0).rgb * w12.x * w3.y;
    float w = w12.x * w0.y + w0.x * w12.y + w12.x * w12.y + w3.x * w12.y + w12.x * w3.y;
    return max(r / w, vec3(0.0));
}

// Clip `history` toward the box centre until it lies inside the box.
vec3 clipToAabb(vec3 history, vec3 center, vec3 extents) {
    vec3 d = history - center;
    vec3 unit = abs(d) / max(extents, vec3(1e-5));
    float m = max(unit.x, max(unit.y, unit.z));
    return m > 1.0 ? center + d / m : history;
}

void main() {
    ivec2 size = textureSize(currentColor, 0);
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, size))) return;
    vec2 uv = (vec2(p) + 0.5) * pc.invSize;

    vec3 current = texelFetch(currentColor, p, 0).rgb;
    if (pc.resetHistory > 0.5) {
        imageStore(resolved, p, vec4(current, 1.0));
        return;
    }

    vec3 m1 = vec3(0.0);
    vec3 m2 = vec3(0.0);
    float closestDepth = 2.0;
    ivec2 closest = p;
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            ivec2 q = clamp(p + ivec2(x, y), ivec2(0), size - 1);
            vec3 c = rgbToYCoCg(texelFetch(currentColor, q, 0).rgb);
            m1 += c;
            m2 += c * c;
            float d = texelFetch(depthTex, q, 0).r;
            if (d < closestDepth) {
                closestDepth = d;
                closest = q;
            }
        }
    }
    vec3 mean = m1 / 9.0;
    vec3 sigma = sqrt(max(m2 / 9.0 - mean * mean, vec3(0.0)));
    const float kGamma = 1.0;

    vec2 velocity = texelFetch(velocityTex, closest, 0).rg;
    vec2 historyUv = uv - velocity;
    if (any(lessThan(historyUv, vec2(0.0))) || any(greaterThan(historyUv, vec2(1.0)))) {
        imageStore(resolved, p, vec4(current, 1.0));
        return;
    }

    vec3 history = rgbToYCoCg(sampleHistoryCatmullRom(historyUv, vec2(size)));
    history = clipToAabb(history, mean, sigma * kGamma);
    history = yCoCgToRgb(history);

    // Faster convergence while moving: sub-pixel motion resamples history
    // every frame, and each resample blurs it slightly.
    float motionPixels = length(velocity * vec2(size));
    float alpha = mix(pc.feedback, 0.25, saturate(motionPixels / 16.0));

    float wCurrent = alpha / (1.0 + luminance(current));
    float wHistory = (1.0 - alpha) / (1.0 + luminance(history));
    vec3 result = (current * wCurrent + history * wHistory) / (wCurrent + wHistory);
    imageStore(resolved, p, vec4(max(result, vec3(0.0)), 1.0));
}
